{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cali-corral.invalid/schema/template-v1.json",
  "title": "Cali Corral CALCRIM template, schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "source", "review", "body"],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3,4}[A-Z]?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "release", "revision_line", "body_sha256"],
      "properties": {
        "file": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "revision_line": {
          "type": "string"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "review": {
      "enum": ["machine-checked", "reviewed"]
    },
    "people": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": {
            "type": "string"
          },
          "uses": {
            "type": "array",
            "items": {
              "enum": ["name", "title", "agency"]
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{3,4}[A-Z]?$"
          },
          "reason": {
            "type": "string"
          },
          "kind": {
            "enum": ["reference", "definition", "lesser_included"]
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bench_note": {
            "type": "string"
          }
        }
      }
    },
    "errata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "note", "status"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": ["spacing", "punctuation", "wording", "structure", "title", "other"]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          },
          "status": {
            "enum": ["proposed", "confirmed"]
          }
        }
      }
    },
    "body": {
      "$ref": "#/$defs/blocks"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": ["boolean", "choice", "multi"]
        },
        "prompt": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "articleFor": {
          "type": "string",
          "description": "For an (a/an) choice: the field whose value follows the article, used to suggest an answer."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "type": {
            "const": "boolean"
          }
        }
      },
      "then": {
        "properties": {
          "options": false
        }
      },
      "else": {
        "required": ["options"]
      }
    },
    "content": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/inlines"
        }
      ]
    },
    "inlines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inline"
      }
    },
    "inline": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["em"],
          "properties": {
            "em": {
              "$ref": "#/$defs/content"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^(count|text\\.[a-z][a-z0-9_]*|[a-z][a-z0-9_]*\\.(name|title|agency))$"
            },
            "hint": {
              "type": "string"
            },
            "noBlank": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["opt", "if"],
          "properties": {
            "opt": {
              "$ref": "#/$defs/content"
            },
            "if": {
              "$ref": "#/$defs/condition"
            },
            "unclosed": {
              "$ref": "#/$defs/id"
            },
            "unopened": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["options"],
          "properties": {
            "choice": {
              "$ref": "#/$defs/id"
            },
            "when": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/content"
              }
            },
            "bare": {
              "const": true
            },
            "unclosed": {
              "$ref": "#/$defs/id"
            },
            "unopened": {
              "$ref": "#/$defs/id"
            },
            "link": {
              "type": "object",
              "additionalProperties": false,
              "required": ["q", "map"],
              "properties": {
                "q": {
                  "$ref": "#/$defs/id"
                },
                "map": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "oneOf": [
            {
              "required": ["choice"]
            },
            {
              "required": ["when"]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any", "options"],
          "properties": {
            "any": {
              "$ref": "#/$defs/id"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/content"
              }
            },
            "unclosed": {
              "$ref": "#/$defs/id"
            },
            "unopened": {
              "$ref": "#/$defs/id"
            },
            "bare": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sep"],
          "properties": {
            "sep": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pronoun", "forms"],
          "properties": {
            "pronoun": {
              "$ref": "#/$defs/id"
            },
            "forms": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "string"
              }
            },
            "bare": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["agree", "sg", "pl"],
          "properties": {
            "agree": {
              "$ref": "#/$defs/id"
            },
            "sg": {
              "type": "string"
            },
            "pl": {
              "type": "string"
            },
            "alt": {
              "const": true
            },
            "onlyIf": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["note"],
          "properties": {
            "note": {
              "type": "string"
            },
            "governs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["erratum"],
          "properties": {
            "erratum": {
              "$ref": "#/$defs/id"
            },
            "printed": {
              "type": "string",
              "pattern": "^[\\[\\]()/]+$"
            }
          }
        }
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note"],
      "properties": {
        "note": {
          "type": "string"
        },
        "governs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/inlines"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["p"],
          "properties": {
            "p": {
              "$ref": "#/$defs/content"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["bullet"],
          "properties": {
            "bullet": {
              "$ref": "#/$defs/content"
            }
          }
        },
        {
          "$ref": "#/$defs/note"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["opt", "if"],
          "properties": {
            "opt": {
              "$ref": "#/$defs/blocks"
            },
            "if": {
              "$ref": "#/$defs/condition"
            },
            "unclosed": {
              "$ref": "#/$defs/id"
            },
            "unopened": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["elements"],
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/element"
                  },
                  {
                    "$ref": "#/$defs/note"
                  },
                  {
                    "$ref": "#/$defs/group"
                  }
                ]
              }
            },
            "conj": {
              "type": "string"
            },
            "style": {
              "enum": ["number", "alpha"]
            },
            "plain": {
              "const": true
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alt", "options"],
      "properties": {
        "alt": {
          "$ref": "#/$defs/id"
        },
        "or": {
          "enum": ["OR", "[OR]", "AND", "[AND]"]
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["elements"],
            "properties": {
              "note": {
                "type": "string"
              },
              "elements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/element"
                }
              },
              "unclosed": {
                "$ref": "#/$defs/id"
              },
              "unopened": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "and": {
          "enum": ["AND", "[AND]", "OR", "[OR]"]
        },
        "andOutside": {
          "const": true
        },
        "if": {
          "$ref": "#/$defs/condition"
        },
        "unclosed": {
          "$ref": "#/$defs/id"
        },
        "unopened": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "text", "end"],
      "properties": {
        "n": {
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/content"
        },
        "end": {
          "enum": [";", ".", "(;/.)", ":", ""]
        },
        "and": {
          "enum": ["AND", "[AND]", "OR", "[OR]"]
        },
        "if": {
          "$ref": "#/$defs/condition"
        },
        "unclosed": {
          "$ref": "#/$defs/id"
        },
        "unopened": {
          "$ref": "#/$defs/id"
        },
        "andOutside": {
          "const": true
        }
      }
    }
  }
}
