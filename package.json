{
  "name": "cali-corral",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "validate": "pnpm --filter @cali-corral/engine validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
